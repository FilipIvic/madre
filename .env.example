# --- Google Calendar (required) -------------------------------------------
# From the service account JSON key you download in Google Cloud Console.
GOOGLE_CLIENT_EMAIL="madre-rezervacije@your-project.iam.gserviceaccount.com"
# Keep the quotes and the literal \n sequences exactly as they appear in the JSON.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
# The calendar you shared with the service account. Found in
# Google Calendar -> calendar settings -> "Integrate calendar" -> Calendar ID.
GOOGLE_CALENDAR_ID="abc123@group.calendar.google.com"

# --- Capacity (optional) ---------------------------------------------------
# Total guests seatable in any overlapping 90-minute window. Default: 30.
SEATS_PER_SLOT="30"

# --- Email (optional — reservations work without it) -----------------------
# https://resend.com — free tier is 3000 emails/month.
RESEND_API_KEY=""
# Until you verify your own domain, leave this unset and Resend's
# onboarding@resend.dev sender is used automatically.
RESEND_FROM="Madre Bistro <rezervacije@madre-bistro.hr>"
# Where new-booking notifications go. Defaults to madre.split@gmail.com.
OWNER_EMAIL="madre.split@gmail.com"
